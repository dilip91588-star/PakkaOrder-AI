# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL 8+ Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=pakka_order_ai

# Google Gemini API (Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_TIMEOUT_MS=30000

# WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Cryptographic Audit Log Signing
AUDIT_SIGNING_SECRET=your_audit_signing_secret_here
